@model APPR_POE_FINAL.Models.ReliefOperation
@{ ViewData["Title"] = "Create Update"; }
<div class="container py-5">
    <h2>Post Relief Update</h2>
    <form asp-action="Create" method="post" class="w-50">
        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Location" class="form-label"></label>
            <input asp-for="Location" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Update" class="form-label"></label>
            <textarea asp-for="Update" class="form-control"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Post</button>
    </form>
</div>
