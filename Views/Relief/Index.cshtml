@model IEnumerable<APPR_POE_FINAL.Models.ReliefOperation>
@{ ViewData["Title"] = "Relief Operations"; }
<div class="container py-5">
    <div class="alert alert-info">
        <strong>Helper Test:</strong> @ViewBag.ReliefStatusMessage
    </div>
    <h2>Relief Operations</h2>
    <a asp-action="Create" class="btn btn-success mb-3">Post New Update</a>
    @foreach (var op in Model)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h4>@op.Title</h4>
                <p><strong>Location:</strong> @op.Location</p>
                <p>@op.Update</p>
                <small>@op.DatePosted.ToString("dd MMM yyyy")</small>
            </div>
        </div>
    }
</div>
